PORT=5000

# Supabase PostgreSQL Connection
# Replace [YOUR-PASSWORD] and [PROJECT-REF] with your actual values
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# OR use individual parameters:
DB_USER=postgres
DB_HOST=db.[PROJECT-REF].supabase.co
DB_NAME=postgres
DB_PASSWORD=[YOUR-PASSWORD]
DB_PORT=5432

# Supabase API URLs and Keys
SUPABASE_URL=replace_with_environment_value
SUPABASE_ANON_KEY=replace_with_environment_value
SUPABASE_SERVICE_KEY=your_supabase_anon_key

# JWT Secret (use your own secure random string)
JWT_SECRET=replace_with_environment_value
JWT_EXPIRES_IN=7d
